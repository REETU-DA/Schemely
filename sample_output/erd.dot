digraph ERD {
  rankdir=LR; splines=true; nodesep=0.5; ranksep=0.9;
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#0F5B78"];
  t0 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F6FAFB"><TR><TD COLSPAN="2" BGCOLOR="#0F5B78"><FONT COLOR="white"><B>courses</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Course_ID">course_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Course_Name">course_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Fee">fee</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&nbsp;</FONT></TD></TR></TABLE>>];
  t1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F6FAFB"><TR><TD COLSPAN="2" BGCOLOR="#0F5B78"><FONT COLOR="white"><B>enrollments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Enrollment_ID">enrollment_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Student_ID">student_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Course_ID">course_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Is_Active">is_active</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&nbsp;</FONT></TD></TR></TABLE>>];
  t2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F6FAFB"><TR><TD COLSPAN="2" BGCOLOR="#0F5B78"><FONT COLOR="white"><B>payments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Payment_ID">payment_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Enrollment_ID">enrollment_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Amount">amount</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Paid_On">paid_on</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Mode">mode</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&nbsp;</FONT></TD></TR></TABLE>>];
  t3 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F6FAFB"><TR><TD COLSPAN="2" BGCOLOR="#0F5B78"><FONT COLOR="white"><B>batches</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Batch_ID">batch_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Course_ID">course_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Start_Date">start_date</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&nbsp;</FONT></TD></TR></TABLE>>];
  t4 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F6FAFB"><TR><TD COLSPAN="2" BGCOLOR="#0F5B78"><FONT COLOR="white"><B>students</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Student_ID">student_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Student_Name">student_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Phone">phone</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Admission_Date">admission_date</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="City">city</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&nbsp;</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Postal_Code">postal_code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&nbsp;</FONT></TD></TR></TABLE>>];
  t0:Course_ID -> t3:Course_ID [dir=both, arrowtail=tee, arrowhead=tee, taillabel="1", headlabel="1"];
  t1:Enrollment_ID -> t2:Enrollment_ID [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="N"];
}